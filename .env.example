# ─────────────────────────────────────────────────────────────────────────────
# ArthaFlow AI Generator — Environment Variables
# Copy this file to .env.local and fill in your keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider ───────────────────────────────────────────────────────────────
# Controls which AI provider is used for all vision + generation tasks.
# Options: deepseek | openai | claude
# Default: deepseek
AI_PROVIDER=deepseek

# ── DeepSeek (default — cheapest) ────────────────────────────────────────────
# Get your key: https://platform.deepseek.com/api_keys
# Free tier: 5M tokens on signup
# Vision + generation model: deepseek-v4-flash
DEEPSEEK_API_KEY=

# Optional: DeepInfra key for DeepSeek-OCR-2 (superior document OCR model)
# Model ID: deepseek-ai/DeepSeek-OCR-2
# Get key: https://deepinfra.com
# DEEPINFRA_API_KEY=

# ── OpenAI (activate when credits available) ──────────────────────────────────
# Set AI_PROVIDER=openai to use this.
# Vision model:     gpt-4o
# Generation model: gpt-4o-mini
OPENAI_API_KEY=

# ── Claude / Anthropic (activate when credits available) ──────────────────────
# Set AI_PROVIDER=claude to use this.
# Requires: npm install @anthropic-ai/sdk
# Then uncomment the Claude section in src/lib/ai/aiClient.ts
# Vision model:     claude-sonnet-4-5-20251001
# Generation model: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Future: Storage (Cloudinary) ─────────────────────────────────────────────
# Needed when upgrading from base64 in-request to pre-upload pipeline (Phase 2)
# CLOUDINARY_CLOUD_NAME=arthaflow
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=arthaflow_source_docs

# ── Future: Database (MongoDB) ────────────────────────────────────────────────
# Needed when manufacturer profiles + document vault are added (Phase 2)
# MONGODB_URI=mongodb+srv://...

# ── Future: Notifications (WhatsApp) ─────────────────────────────────────────
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
